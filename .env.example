# Use a unique password of at least 12 characters for the first admin sign-in.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# The site's public address once it has a domain, e.g. https://daymarkcoffee.com
# Used for the share card, sitemap, robots.txt and search listings.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Supabase Project URL and server-only secret key. Never use a SUPABASE_* secret in client components.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_key
